    {
      "id": "fst-woodcutter",
      "type": "adventure",
      "x": 900,
      "speaker": "Woodcutter",
      "lines": [
        "Small roads bring small travelers. You're the one they asked after.",
        "A family — worn thin, hopeful. Camped here three nights past, then east through the hollow.",
        "Mind the wood past the shrine. The boars are foul-tempered this season."
      ],
      "choices": [
        "Thank him and press on",
        "Ask about the hollow"
      ],
      "responses": [
        "East, then. Walk loud — the wood dislikes surprises.",
        "Low ground, wet ground. A tree came down across the path — you'll need your shoulder."
      ]
