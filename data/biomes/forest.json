      "type": "adventure",
      "x": 4900,
      "speaker": "Mira",
      "requires": [
        "+mira"
      ],
      "lines": [
        "Stop. Wire, knee height, freshly sprung — and it wasn't set for deer.",
        "Someone walked into this ahead of us and tore themselves free.",
        "They were moving east. And they were bleeding."
      ],
      "choices": [
        "Follow the sign",
        "Leave it"
      ],
      "responses": [
        "The trail bends off the path and ends at a torn strip of cloth. She folds it away without a word.",
        "She looks at the wire a moment longer than you do, then follows."
      ],
      "outcomes": [
        {
          "artifacts": 1,
          "mark": {
            "snare_trail": 1
          }
        },
        {}
      ]
    },
