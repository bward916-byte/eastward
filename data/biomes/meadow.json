    {
      "id": "mdw-mira-after",
      "type": "adventure",
      "x": 11900,
      "speaker": "Mira",
      "requires": [
        "+mira"
      ],
      "lines": [
        "Six of them, together, hunting the road itself.",
        "That's not how wolves behave. Something east of here has pushed them out of their own country.",
        "Whatever it is, we're walking toward it."
      ],
      "choices": [
        "Then we'd better find more hands"
      ],
      "responses": [
        "She almost smiles. That's the first sensible thing you've said."
      ],
