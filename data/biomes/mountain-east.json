    {
      "id": "east-fen",
      "type": "adventure",
      "x": 1500,
      "speaker": "",
      "lines": [
        "A dog sits square in the middle of the road, facing west, waiting.",
        "It is thin and its collar is a strip of good cloth, cut from something better. It does not beg and it does not run.",
        "When you step past, it stands and walks at your heel as though this had all been arranged some time ago."
      ],
      "choices": [
        "Let it come",
        "Send it back"
      ],
      "responses": [
        "It falls in tight at your left knee and stays there.",
        "It sits back down in the road, facing west, and waits for whoever is next."
      ],
      "outcomes": [
        {
          "companion": "fen",
          "mark": {
            "fen": "joined"
          }
        },
        {}
      ]
    },
    {
      "id": "east-bats",
