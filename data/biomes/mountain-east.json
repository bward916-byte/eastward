      "x": 1550,
      "kind": "bat",
      "count": 2,
      "blocking": false
    },
    {
      "id": "east-widow",
      "type": "adventure",
      "x": 2200,
      "speaker": "Woman at the Cairn",
      "lines": [
        "You've the look of the road on you. Sit a moment, it costs nothing.",
        "I keep this cairn. People leave word here for the ones behind them — it's the last stone before the water."
      ],
      "choices": [
        "Has a family passed? Asking after a child.",
        "Only rest, thank you."
      ],
      "responses": [
        "She goes still. Yes, she says. Not long ago. They left word and went down to the crossing to wait. They have been waiting a while now.",
        "Then rest. The wind here is kinder than it looks."
      ],
      "outcomes": [
        {
          "mark": {
            "family_sign": "cairn"
          }
        },
        {}
      ]
    },
