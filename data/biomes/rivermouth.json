    {
      "id": "riv-corran",
      "type": "adventure",
      "x": 5000,
      "speaker": "Corran",
      "requiresAny": [
        "+corran",
        "@corran=saved",
        "fst-wounded=0"
      ],
      "lines": [
        "There's a family been at the low fires eleven days, asking after a child.",
        "But nobody's crossing tonight. The whole bank knows it — there's something come down the far shore and it's been circling since dusk.",
        "If it comes at the fires, it comes through us first."
      ],
      "choices": [
        "Then we hold the fires"
      ],
      "responses": [
        "He sets his shield down where the shingle turns to grass and does not pick it back up."
      ],
      "outcomes": [
